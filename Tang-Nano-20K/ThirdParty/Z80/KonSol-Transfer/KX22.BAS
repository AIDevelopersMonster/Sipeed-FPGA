10 REM KONSOL KX2 KX22 / 0.2.1 WIRE / KX1 P/G COMPATIBLE
20 H$="0123456789ABCDEF":DIM V%(63)
25 WIDTH 0:REM NO BBC BASIC AUTO-WRAP OF HEX FRAMES
28 REM V PROBE / L LIST / D DELETE / R RENAME
30 PRINT "KX1:READY"
40 INPUT C$
42 IF C$="V" THEN PRINT "KX2:HELLO:0.2.1:LDR":GOTO 30
50 IF C$="P" THEN GOSUB 1000:GOTO 30
60 IF C$="G" THEN GOSUB 3000:GOTO 30
62 IF C$="L" THEN GOSUB 5000:GOTO 30
64 IF C$="D" THEN GOSUB 6000:GOTO 30
66 IF C$="R" THEN GOSUB 7000:GOTO 30
68 IF C$="Q" THEN PRINT "KX1:BYE":END
80 PRINT "KX1:ERR:MODE":GOTO 30
1000 REM RECEIVE INTO TEMP AND VERIFY BEFORE RENAME
1010 PRINT "KX1:NAME":INPUT F$
1020 IF LEFT$(F$,2)<>"A:" AND LEFT$(F$,2)<>"B:" THEN PRINT "KX1:ERR:DRIVE":RETURN
1030 PRINT "KX1:SIZE":INPUT N%
1040 IF N%<0 OR N%>524288 THEN PRINT "KX1:ERR:SIZE":RETURN
1050 K%=OPENIN(F$)
1060 IF K%<>0 THEN CLOSE#K%:PRINT "KX1:ERR:EXISTS":RETURN
1070 T$=LEFT$(F$,2)+"KXFER.TMP"
1080 K%=OPENIN(T$)
1090 IF K%<>0 THEN CLOSE#K%:PRINT "KX1:ERR:STAGE":RETURN
1091 PRINT "KX1:SUM1":INPUT H1%
1092 PRINT "KX1:SUM2":INPUT H2%
1093 IF H1%<0 OR H1%>65520 OR H2%<0 OR H2%>65520 THEN PRINT "KX1:ERR:SUM":RETURN
1100 K%=OPENOUT(T$)
1110 IF K%=0 THEN PRINT "KX1:ERR:CREATE":RETURN
1120 B%=0:Z%=0:S1%=1:S2%=0
1130 PRINT "KX1:GO"
1140 IF Z%>=N% THEN GOTO 1430
1150 M%=N%-Z%:IF M%>64 THEN M%=64
1160 INPUT L$
1170 IF LEN(L$)<8 THEN PRINT "KX1:NAK:";B%:GOTO 1160
1180 IF LEFT$(L$,1)<>"D" OR MID$(L$,8,1)<>":" THEN PRINT "KX1:NAK:";B%:GOTO 1160
1190 V%=VAL(MID$(L$,2,6))
1200 IF V%=B%-1 THEN PRINT "KX1:ACK:";V%:GOTO 1160
1210 IF V%<>B% THEN PRINT "KX1:NAK:";B%:GOTO 1160
1220 IF LEN(L$)<>(11+2*M%) OR MID$(L$,9+2*M%,1)<>":" THEN PRINT "KX1:NAK:";B%:GOTO 1160
1230 C%=0:O%=0
1240 FOR I%=0 TO M%-1
1250 X%=INSTR(H$,MID$(L$,9+2*I%,1))-1
1260 Y%=INSTR(H$,MID$(L$,10+2*I%,1))-1
1270 IF X%<0 OR Y%<0 THEN O%=1:X%=0:Y%=0
1280 V%(I%)=16*X%+Y%:C%=(C%+V%(I%)) MOD 256
1290 NEXT I%
1300 X%=INSTR(H$,MID$(L$,10+2*M%,1))-1
1310 Y%=INSTR(H$,MID$(L$,11+2*M%,1))-1
1320 IF X%<0 OR Y%<0 THEN O%=1
1330 IF O%<>0 THEN PRINT "KX1:NAK:";B%:GOTO 1160
1340 IF 16*X%+Y%<>C% THEN PRINT "KX1:NAK:";B%:GOTO 1160
1350 FOR I%=0 TO M%-1
1360 BPUT#K%,V%(I%)
1370 S1%=(S1%+V%(I%)) MOD 65521
1380 S2%=(S2%+S1%) MOD 65521
1390 NEXT I%
1400 Z%=Z%+M%:PRINT "KX1:ACK:";B%:B%=B%+1
1410 GOTO 1140
1430 CLOSE#K%
1440 K%=OPENIN(T$)
1450 IF K%=0 THEN PRINT "KX1:ERR:READBACK":RETURN
1460 R1%=1:R2%=0
1470 IF N%=0 THEN GOTO 1510
1480 FOR I%=1 TO N%
1490 X%=BGET#K%:R1%=(R1%+X%) MOD 65521:R2%=(R2%+R1%) MOD 65521
1500 NEXT I%
1510 CLOSE#K%
1520 IF R1%<>S1% OR R2%<>S2% OR R1%<>H1% OR R2%<>H2% THEN PRINT "KX1:ERR:VERIFY":RETURN
1530 OSCLI "REN "+F$+"="+T$
1540 PRINT "KX1:DONE:";S1%;":";S2%
1550 RETURN
3000 REM TRANSMIT READ-ONLY - FULL CP-M RECORD SIZE
3010 PRINT "KX1:NAME":INPUT F$
3020 IF LEFT$(F$,2)<>"A:" AND LEFT$(F$,2)<>"B:" THEN PRINT "KX1:ERR:DRIVE":RETURN
3030 K%=OPENIN(F$)
3040 IF K%=0 THEN PRINT "KX1:ERR:NOTFOUND":RETURN
3050 N%=EXT#K%
3060 PRINT "KX1:EXT:";N%
3070 INPUT W%
3080 IF W%<0 OR W%>N% OR W%>524288 THEN CLOSE#K%:PRINT "KX1:ERR:LENGTH":RETURN
3090 PRINT "KX1:GO"
3100 B%=0:Z%=0:S1%=1:S2%=0
3110 IF Z%>=W% THEN GOTO 3260
3120 M%=W%-Z%:IF M%>64 THEN M%=64
3130 L$="":C%=0
3140 FOR I%=1 TO M%
3150 X%=BGET#K%
3160 L$=L$+MID$(H$,X% DIV 16+1,1)+MID$(H$,X% MOD 16+1,1)
3170 C%=(C%+X%) MOD 256:S1%=(S1%+X%) MOD 65521:S2%=(S2%+S1%) MOD 65521
3180 NEXT I%
3190 P$="":T%=100000
3191 FOR J%=1 TO 6
3192 P$=P$+CHR$(48+(B% DIV T%) MOD 10):T%=T% DIV 10
3193 NEXT J%
3194 L$="D"+P$+":"+L$+":"+MID$(H$,C% DIV 16+1,1)+MID$(H$,C% MOD 16+1,1)
3200 PRINT "KX1:";L$
3210 INPUT A$
3220 IF A$<>"A"+P$ THEN PRINT "KX1:";L$:GOTO 3210
3230 B%=B%+1:Z%=Z%+M%
3240 GOTO 3110
3260 CLOSE#K%
3270 PRINT "KX1:DONE:";S1%;":";S2%
3280 RETURN
5000 REM KX2 DIRECTORY - RAW OSCLI OUTPUT BETWEEN SENTINELS
5010 PRINT "KX2:DRIVE":INPUT D$
5020 IF D$<>"A" AND D$<>"B" THEN PRINT "KX2:ERR:DRIVE":RETURN
5030 PRINT "KX2:LIST:BEGIN:";D$
5040 OSCLI "DIR "+D$+":*.*"
5050 PRINT "KX2:LIST:END:";D$
5060 RETURN
6000 REM KX2 DELETE - NEVER DELETE TRANSFER RECEIVER OR STAGE
6010 PRINT "KX2:NAME":INPUT F$
6020 GOSUB 8000:IF E%<>0 THEN PRINT "KX2:ERR:NAME":RETURN
6030 K%=OPENIN(F$)
6040 IF K%=0 THEN PRINT "KX2:ERR:NOTFOUND":RETURN
6050 CLOSE#K%
6060 PRINT "KX2:CONFIRM":INPUT C$
6070 IF C$<>"DELETE "+F$ THEN PRINT "KX2:ERR:CANCEL":RETURN
6080 OSCLI "ERA "+F$
6090 K%=OPENIN(F$)
6100 IF K%<>0 THEN CLOSE#K%:PRINT "KX2:ERR:DELETE":RETURN
6110 PRINT "KX2:DONE:DELETE:";F$
6120 RETURN
7000 REM KX2 RENAME - NO OVERWRITE, SAME DRIVE
7010 PRINT "KX2:SOURCE":INPUT F$
7020 GOSUB 8000:IF E%<>0 THEN PRINT "KX2:ERR:SOURCE":RETURN
7030 PRINT "KX2:DEST":INPUT T$
7040 G$=F$:F$=T$:GOSUB 8000:F$=G$
7050 IF E%<>0 THEN PRINT "KX2:ERR:DEST":RETURN
7060 IF LEFT$(F$,2)<>LEFT$(T$,2) THEN PRINT "KX2:ERR:CROSSDRIVE":RETURN
7070 K%=OPENIN(F$)
7080 IF K%=0 THEN PRINT "KX2:ERR:NOTFOUND":RETURN
7090 CLOSE#K%
7100 K%=OPENIN(T$)
7110 IF K%<>0 THEN CLOSE#K%:PRINT "KX2:ERR:EXISTS":RETURN
7120 PRINT "KX2:CONFIRM":INPUT C$
7130 IF C$<>"RENAME "+F$+" "+T$ THEN PRINT "KX2:ERR:CANCEL":RETURN
7140 OSCLI "REN "+T$+"="+F$
7150 K%=OPENIN(T$)
7160 IF K%=0 THEN PRINT "KX2:ERR:RENAME":RETURN
7170 CLOSE#K%
7180 K%=OPENIN(F$)
7190 IF K%<>0 THEN CLOSE#K%:PRINT "KX2:ERR:SOURCESTILL":RETURN
7200 PRINT "KX2:DONE:RENAME:";T$
7210 RETURN
8000 REM STRICT 8.3 VALIDATION, A/B ONLY, RESERVED NAMES
8010 E%=1
8020 IF LEN(F$)<5 OR LEN(F$)>14 THEN RETURN
8030 IF LEFT$(F$,2)<>"A:" AND LEFT$(F$,2)<>"B:" THEN RETURN
8040 IF INSTR(F$,"KXFER.TMP")<>0 THEN RETURN
8050 IF MID$(F$,3)="KXFER.BBC" OR MID$(F$,3)="KX2FER.BBC" OR MID$(F$,3)="KX21.BBC" OR MID$(F$,3)="KX22.BBC" THEN RETURN
8060 J%=INSTR(F$,".")
8070 IF J%<4 OR J%>11 OR LEN(F$)-J%>3 OR LEN(F$)-J%<1 THEN RETURN
8080 FOR I%=3 TO LEN(F$)
8090 A$=MID$(F$,I%,1)
8100 IF I%=J% THEN GOTO 8130
8110 IF INSTR("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-",A$)=0 THEN RETURN
8130 NEXT I%
8140 E%=0
8150 RETURN
