10 REM KONSOL VGRAPH - ANSI COLOR AND VIETA ON Z80
20 REM TEXT TERMINAL ONLY; NO PLOT OR MODE NEEDED
30 DIM V%(60),U%(60)
40 E$=CHR$(27):F%=1:WIDTH 0
50 PRINT "KONSOL COLOR GRAPH / VIETA ON Z80"
60 INPUT "ANSI COLORS (1=YES, 0=NO): ",F%
70 REPEAT
80 PRINT
90 PRINT "1 X^2   2 2X^2   3 X^2+3"
100 PRINT "4 X^2-4X+1   5 -X^2+4"
110 PRINT "6 X^2-5X+6 (VIETA 2,3)"
120 PRINT "7 X^2+4 (NO REAL ROOTS)"
130 PRINT "8 X^2-4X+4 (DOUBLE ROOT)"
140 PRINT "9 CUSTOM A,B,C   0 EXIT"
150 INPUT "SELECT 0-9: ",M%
160 IF M%=1 THEN A=1:B=0:C=0
170 IF M%=2 THEN A=2:B=0:C=0
180 IF M%=3 THEN A=1:B=0:C=3
190 IF M%=4 THEN A=1:B=-4:C=1
200 IF M%=5 THEN A=-1:B=0:C=4
210 IF M%=6 THEN A=1:B=-5:C=6
220 IF M%=7 THEN A=1:B=0:C=4
230 IF M%=8 THEN A=1:B=-4:C=4
240 IF M%=9 THEN INPUT "A = ",A
250 IF M%=9 THEN INPUT "B = ",B
260 IF M%=9 THEN INPUT "C = ",C
270 IF M%>=1 AND M%<=9 THEN GOSUB 1000
280 UNTIL M%=0
290 IF F%<>0 THEN PRINT E$;"[0m";
300 PRINT "KONSOL VGRAPH: BYE"
310 END
1000 REM COMPUTE ROOTS AND PLOT
1010 IF F%<>0 THEN PRINT E$;"[0m";
1020 PRINT
1030 PRINT "Y=A*X*X+B*X+C;  A=";A;" B=";B;" C=";C
1040 I1%=-1:I2%=-1:IV%=-1:RV%=99:D=-1
1050 IF A=0 THEN GOSUB 1400:GOTO 1190
1060 D=B*B-4*A*C
1070 XV=-B/(2*A):YV=A*XV*XV+B*XV+C
1080 PRINT "DISCRIMINANT D=";D;"  VERTEX X=";XV;" Y=";YV
1090 IF XV>=-6 AND XV<=6 THEN IV%=INT(30+5*XV+0.5)
1100 IF YV>=-10 AND YV<=10 THEN RV%=INT(YV+0.5)
1110 IF D<0 THEN PRINT "D<0: NO REAL ROOTS / NO X-INTERSECTIONS":GOTO 1190
1120 X1=(-B-SQR(D))/(2*A):X2=(-B+SQR(D))/(2*A)
1130 IF X1>X2 THEN Z=X1:X1=X2:X2=Z
1140 PRINT "ROOTS: X1=";X1;" X2=";X2
1150 PRINT "VIETA: X1+X2=";X1+X2;" = -B/A=";-B/A
1160 PRINT "VIETA: X1*X2=";X1*X2;" = C/A=";C/A
1170 IF X1>=-6 AND X1<=6 THEN I1%=INT(30+5*X1+0.5)
1180 IF X2>=-6 AND X2<=6 THEN I2%=INT(30+5*X2+0.5)
1190 PRINT "* CURRENT . REF X^2  1/2 ROOTS  V VERTEX"
1200 PRINT "X=-6..+6 (61 COLS); Y=-10..+10"
1210 FOR I%=0 TO 60
1220 X=(I%-30)/5:Y=A*X*X+B*X+C:Z=X*X
1230 V%(I%)=99:U%(I%)=99
1240 IF Y>=-10 AND Y<=10 THEN V%(I%)=INT(Y+0.5)
1250 IF Z>=-10 AND Z<=10 THEN U%(I%)=INT(Z+0.5)
1260 NEXT I%
1270 GOSUB 1800
1280 IF I1%>=0 OR I2%>=0 THEN GOSUB 2600
1290 PRINT "LEFT=-6 CENTRE=0 RIGHT=+6"
1300 RETURN
1400 REM A=0: LINEAR OR CONSTANT, NO VIETA
1410 PRINT "A=0: LINEAR/CONSTANT; VIETA NOT APPLICABLE"
1420 IF B=0 THEN PRINT "B=0: NO UNIQUE ROOT":RETURN
1430 X1=-C/B:PRINT "LINEAR ROOT X=";X1
1440 IF X1>=-6 AND X1<=6 THEN I1%=INT(30+5*X1+0.5)
1450 RETURN
1800 REM PLOT 21 ROWS, ANSI COLOR RUNS
1810 FOR R%=10 TO -10 STEP -1
1820 PRINT RIGHT$("   "+STR$(R%),3);" ";
1830 P$="":Q%=-1
1840 FOR I%=0 TO 60
1850 S$=" ":K%=0
1860 IF R%=0 THEN S$="-":K%=1
1870 IF I%=30 THEN S$="|":K%=1
1880 IF R%=0 AND I%=30 THEN S$="+":K%=1
1890 IF U%(I%)=R% THEN S$=".":K%=2
1900 IF V%(I%)=R% THEN S$="*":K%=3
1910 IF I%=IV% AND R%=RV% THEN S$="V":K%=5
1920 IF R%=0 AND I%=I1% THEN S$="1":K%=4
1930 IF R%=0 AND I%=I2% THEN S$="2":K%=4
1940 IF R%=0 AND I1%=I2% AND I1%>=0 AND I%=I1% THEN S$="X":K%=4
1950 IF K%<>Q% THEN GOSUB 3000:Q%=K%
1960 P$=P$+S$
1970 NEXT I%
1980 GOSUB 3000
1990 K%=0:GOSUB 4000:PRINT
2000 NEXT R%
2010 RETURN
2600 REM VIETA ROOT DIAGRAM ON NUMBER LINE
2610 PRINT "VIETA ROOT LINE: -6 TO +6"
2620 PRINT "    ";
2630 P$="":Q%=-1
2640 FOR I%=0 TO 60
2650 S$="-":K%=1
2660 IF I%=30 THEN S$="|":K%=1
2670 IF I%=IV% AND D>=0 THEN S$="M":K%=5
2680 IF I%=I1% THEN S$="1":K%=4
2690 IF I%=I2% THEN S$="2":K%=4
2700 IF I%=I1% AND I%=I2% AND I1%>=0 THEN S$="X":K%=4
2710 IF K%<>Q% THEN GOSUB 3000:Q%=K%
2720 P$=P$+S$
2730 NEXT I%
2740 GOSUB 3000
2750 K%=0:GOSUB 4000:PRINT
2760 PRINT "    1=X1 2=X2 M=MIDPOINT; X=OVERLAP"
2770 IF A<>0 AND D>=0 THEN PRINT "M=(X1+X2)/2=";(X1+X2)/2;" = -B/(2A)=";-B/(2*A)
2780 RETURN
3000 REM FLUSH PENDING RUN THEN CHANGE FOREGROUND
3010 IF P$<>"" THEN PRINT P$;:P$=""
3020 IF F%=0 THEN RETURN
3030 GOSUB 4000
3040 RETURN
4000 REM ANSI COLORS: AXES CYAN REF BLUE CURRENT GREEN
4010 IF F%=0 THEN RETURN
4020 IF K%=0 THEN PRINT E$;"[0m";
4030 IF K%=1 THEN PRINT E$;"[36m";
4040 IF K%=2 THEN PRINT E$;"[96m";
4050 IF K%=3 THEN PRINT E$;"[92m";
4060 IF K%=4 THEN PRINT E$;"[93m";
4070 IF K%=5 THEN PRINT E$;"[95m";
4080 RETURN