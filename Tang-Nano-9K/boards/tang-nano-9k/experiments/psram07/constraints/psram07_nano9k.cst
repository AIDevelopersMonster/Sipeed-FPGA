// LAB-07 PSRAM: 27 MHz crystal / reset S1, UART + 6 LEDs.
// Proven baseline LAB-06 pin/bank assignments. PSRAM special ports
// are INTERNAL to GW1NR-9C QN88P; do not assign IO_LOC for O_psram*.
IO_LOC "sys_clk" 52;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "sys_resetn" 3;
IO_PORT "sys_resetn" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC "uart_txp" 17;
IO_PORT "uart_txp" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "led[0]" 10;
IO_LOC "led[1]" 11;
IO_LOC "led[2]" 13;
IO_LOC "led[3]" 14;
IO_LOC "led[4]" 15;
IO_LOC "led[5]" 16;
IO_PORT "led[0]" IO_TYPE=LVCMOS18;
IO_PORT "led[1]" IO_TYPE=LVCMOS18;
IO_PORT "led[2]" IO_TYPE=LVCMOS18;
IO_PORT "led[3]" IO_TYPE=LVCMOS18;
IO_PORT "led[4]" IO_TYPE=LVCMOS18;
IO_PORT "led[5]" IO_TYPE=LVCMOS18;
